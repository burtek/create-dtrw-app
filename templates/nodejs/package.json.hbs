    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest watch"
  },
  "dependencies": {
    "@dtrw/fastify-shared": "^1.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "fastify-raw-body": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "validator": "^13.15.35",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dtrw/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "@types/validator": "^13.15.10",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "nodemon": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^26.5.0"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "create-dtrw-app": {
    "generatorVersion": "{{ generatorVersion }}",
    "templateUsed": "nodejs"
  }
