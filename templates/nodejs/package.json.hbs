{
  "name": "{{ packageName }}",
  "version": "1.0.0",
  "description": "",
{{#if author}}
  "author": "{{{author}}}",
{{/if}}
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "dev:tsx": "tsx watch --env-file=.env.development --clear-screen=false src/server.ts",
    "dev:typecheck": "tsc --watch",
