{
  "name": "{{ packageName }}",
  "private": true,
  "version": "1.0.0",
  "type": "module",
{{#if author}}
  "author": "{{{author}}}",
{{/if}}
  "scripts": {
    "dev": "vite --clearScreen false",
    "prebuild": "tsc",
    "build": "vite build",
    "typecheck": "tsc",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@dtrw/eslint-config": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "jsdom": "^30.1.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "create-dtrw-app": {
    "generatorVersion": "{{ generatorVersion }}",
    "templateUsed": "reactjs"
  }
}
