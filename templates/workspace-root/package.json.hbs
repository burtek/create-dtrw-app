{
  "name": "{{ longName }}",
  "version": "1.0.0",
{{#if repo}}
  "repository": "{{{ repo }}}",
{{/if}}
{{#if author}}
  "author": "{{{author}}}",
{{/if}}
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@dtrw/create-dtrw-app": "^1.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "catalog:",
    "commit-and-tag-version": "^13.1.0",
    "husky": "^9.1.7",
    "rimraf": "^6.1.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "check-all": "pnpm run validate && pnpm -r --parallel --aggregate-output --no-bail run '/^(lint|typecheck|test)$/'",
    "dev": "pnpm run validate && pnpm -r --parallel run /^dev/",
    "prebuild": "pnpm run validate",
    "build": "pnpm -r --parallel --aggregate-output --no-bail run build",
    "preassemble": "pnpm run validate && pnpm run clear && pnpm run build",
    "assemble": "pnpm -r --parallel --aggregate-output --no-bail run assemble",
    "lint": "pnpm -r --parallel --aggregate-output --no-bail run lint",
    "typecheck": "pnpm -r --parallel --aggregate-output --no-bail run typecheck",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:playwright": "playwright test",
    "test:all": "pnpm --parallel --aggregate-output --no-bail run /^test(:playwright)?$/",
    "prepare": "husky",
    "prerelease": "pnpm run check-all",
    "release": "commit-and-tag-version",
    "clear": "rimraf packages/*/dist packages/*/.assembled playwright-report test-results",
    "validate": "node scripts/validate-workspace.mjs"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "engines": {
    "node": "^26.5.0"
  }
}
