name: Main workflow

on:
  push:
    branches: [master]
  pull_request:
    branches: [master]

env:
  APP_NAME: {{{ shortName }}}
  NODE_VERSION: 26.5

permissions:
  contents: read

jobs:
  test:
    name: Run tests, lint, and build
    runs-on: ubuntu-latest

    steps:
      - id: checkout
        name: Checkout code
        uses: actions/checkout@v7
      - id: setup-node
        name: Setup node with pnpm
        uses: pnpm/setup@v2
        with:
          runtime: node@$\{{ env.NODE_VERSION }}
          cache: true
      - id: tests
        name: Run tests
        run: pnpm test
        background: true
      - id: lint
        name: Run lint
        run: pnpm lint
        background: true
      - id: build
        name: Build
        run: pnpm build
        background: true
      - id: wait
        name: Wait for background jobs to finish
        wait: [tests, lint, build]

  get-playwright-version:
    name: Get playwright version
    runs-on: ubuntu-latest
    outputs:
      playwrightversion: $\{{ steps.get-version.outputs.playwrightversion }}
    steps:
      - id: checkout
        name: Checkout code
        uses: actions/checkout@v7
      - id: get-version
        name: Get version
        run: echo "playwrightversion=$(cat package.json| jq '.devDependencies.["@playwright/test"]' -r)" >> "$GITHUB_OUTPUT"

  test-playwright:
    name: Run Playwright tests
    runs-on: ubuntu-latest
    needs: [get-playwright-version]
    container:
      image: mcr.microsoft.com/playwright:v${{ needs.get-playwright-version.outputs.playwrightversion }}-noble
      options: --user 1001
    steps:
      - id: checkout
        name: Checkout code
        uses: actions/checkout@v7
      - id: setup-node
        name: Setup node with pnpm
        uses: pnpm/setup@v2
        with:
          runtime: node@$\{{ env.NODE_VERSION }}
          cache: true
      - id: run-playwirght
        name: Run Playwright tests
        run: pnpm exec playwright test
      - id: upload-playwright-report
        uses: actions/upload-artifact@v7
        if: $\{{ !cancelled() }}
        with:
            name: playwright-report
            path: playwright-report/
            retention-days: 30

  test-build-image:
    name: Test building docker image
    if: github.event_name == 'pull_request'
    uses: ./.github/workflows/build-docker.yml
    permissions:
      contents: read
      packages: write

  test-ssh: # to catch ssh issues early, as the job using the connection is late in the workflow
    name: Test SSH connection to VPS
    runs-on: ubuntu-latest
    steps:
      - id: test-ssh
        name: Test SSH
        uses: burtek/setup-ssh@v1
        with:
          host: $\{{ secrets.SSH_HOST }}
          port: $\{{ secrets.SSH_PORT }}
          user: $\{{ secrets.SSH_USER }}
          private_key: $\{{ secrets.SSH_PRIVATE_KEY }}
          known_hosts: $\{{ secrets.SSH_KNOWN_HOSTS }}
          alias: production
          test_connection: true

  create-release:
    name: Create release
    needs: [test, test-playwright]
    if: github.event_name == 'push'
    runs-on: ubuntu-latest
    permissions:
      contents: write
    outputs:
      version: $\{{ steps.output-version.outputs.version }}
      release-commit-sha: $\{{ steps.output-version.outputs.release-commit-sha }}
    steps: 
      - id: checkout
        name: Checkout repo
        uses: actions/checkout@v7
        with:
          fetch-depth: 0  # Needed for standard-version to access tags
      - id: setup-node
        name: Setup node with pnpm
        uses: pnpm/setup@v2
        with:
          runtime: node@$\{{ env.NODE_VERSION }}
          cache: true
      - id: release
        name: Bump version and generate changelog
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          pnpm exec commit-and-tag-version --no-verify #skips tests before release and on precommit
      - id: push
        name: Push release commit and tags
        uses: ad-m/github-push-action@v1.3.0
        with:
          branch: master
          tags: true
        background: true
      - id: output-version
        name: Output new version and release commit sha
        run: |
          echo "version=$(node -p "require('./package.json').version")" >> "$GITHUB_OUTPUT"
          echo "release-commit-sha=$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"
        background: true
      - id: wait
        name: Wait for background jobs to finish
        wait: [push, output-version]

  build-image-for-deploy:
    name: Build docker image
    needs: create-release
    uses: ./.github/workflows/build-docker.yml
    permissions:
      contents: read
      packages: write
    with:
      ref: $\{{ needs.create-release.outputs.release-commit-sha }}
      push-images: true
      version: v$\{{ needs.create-release.outputs.version }}

  deploy:
    runs-on: ubuntu-latest
    needs: [create-release, build-image-for-deploy, test-ssh]
    concurrency:
      group: deploy-production
      cancel-in-progress: false
    steps:
      - id: setup-ssh
        name: Setup SSH
        uses: burtek/setup-ssh@v1
        with:
          host: $\{{ secrets.SSH_HOST }}
          port: $\{{ secrets.SSH_PORT }}
          user: $\{{ secrets.SSH_USER }}
          private_key: $\{{ secrets.SSH_PRIVATE_KEY }}
          known_hosts: $\{{ secrets.SSH_KNOWN_HOSTS }}
          alias: production
          test_connection: true
      - id: checkout
        name: Checkout code
        uses: actions/checkout@v7
      - id: deploy
        name: Deploy docker-compose and start app
        run: |
          ssh production '
              set -eu

              mkdir -p /apps/$\{{ env.APP_NAME }}
              cd /apps/$\{{ env.APP_NAME }}
              cat > docker-compose.yml.new
              mv docker-compose.yml.new docker-compose.yml

              export VERSION_TAG="v$\{{ needs.create-release.outputs.version }}"

              docker compose pull
              docker compose up -d
          ' < docker-compose.yml
