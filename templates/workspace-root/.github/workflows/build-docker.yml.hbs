name: Build docker images

on:
  workflow_call:
    inputs:
      ref:
        required: false
        type: string
        default: $\{{ github.sha }}
      push-images:
        required: false
        type: boolean
        default: false
      version:
        required: false
        type: string

permissions:
  contents: read

jobs:
  discover:
    name: Get all packages
    runs-on: ubuntu-latest
    outputs:
      packages: $\{{ steps.get-packages-list.outputs.packages }}
    steps:
      - id: checkout
        name: Checkout code
        uses: actions/checkout@v7
        with:
          ref: $\{{ inputs.ref }}
      - id: get-packages-list
        name: Discover buildable packages
        run: |
          packages=$(find packages -mindepth 2 -maxdepth 2 -type f -name Dockerfile -printf '%h\n' \
            | jq -R -s -c 'split("\n") | map(select(length > 0))')

          echo "packages=$packages" >> "$GITHUB_OUTPUT"
  build:
    name: Build docker image for $\{{ matrix.path }}
    runs-on: ubuntu-latest
    needs: discover
    permissions:
      contents: read
      packages: write
    strategy:
      fail-fast: $\{{ inputs.push-images == true || inputs.push-images == 'true' }} # only fail fast when building, not when testing a PR
      matrix:
        path: $\{{ fromJSON(needs.discover.outputs.packages) }}
    steps:
      - id: package-name
        name: Output package name
        run: |
          PACKAGE_NAME="$\{{ matrix.path }}"
          PACKAGE_NAME="${PACKAGE_NAME#packages/}"
          echo "package-name=$PACKAGE_NAME" >> "$GITHUB_OUTPUT"
      - id: checkout
        name: Checkout code
        uses: actions/checkout@v7
        with:
          ref: $\{{ inputs.ref }}
      - id: setup-buildx
        name: Setup buildx
        uses: docker/setup-buildx-action@v4
      - id: login-ghcr
        name: Login to GHCR
        uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: $\{{ github.actor }}
          password: $\{{ secrets.GITHUB_TOKEN }}
      - id: test-image
        if: inputs.push-images == false || inputs.push-images == 'false'
        name: Test build image
        uses: docker/build-push-action@v7
        with:
          context: .
          file: $\{{ matrix.path }}/Dockerfile
          push: false
          cache-from: type=registry,ref=ghcr.io/$\{{ github.repository }}/$\{{ steps.package-name.outputs.package-name }}:buildcache
      - id: meta
        run: echo "created=$(date -u +'%Y-%m-%dT%H:%M:%SZ')" >> "$GITHUB_OUTPUT"
      - id: build-image
        if: inputs.push-images == true || inputs.push-images == 'true'
        name: Build image
        uses: docker/build-push-action@v7
        with:
          context: .
          file: $\{{ matrix.path }}/Dockerfile
          build-args: |
            COMMIT_SHA=$\{{ inputs.ref }}
          push: true
          labels: |
            org.opencontainers.image.title=$\{{ steps.package-name.outputs.package-name }}
            org.opencontainers.image.description={{ capitalizeFirstLetter shortName }} app - $\{{ steps.package-name.outputs.package-name }}
            org.opencontainers.image.source=https://github.com/$\{{ github.repository }}/tree/master/$\{{ matrix.path }}
            org.opencontainers.image.url=https://github.com/$\{{ github.repository }}
            org.opencontainers.image.version=$\{{ inputs.version }}
            org.opencontainers.image.revision=$\{{ inputs.ref }}
            org.opencontainers.image.created=$\{{ steps.meta.outputs.created }}
            org.opencontainers.image.licenses=MIT
          tags: |
            ghcr.io/$\{{ github.repository }}/$\{{ steps.package-name.outputs.package-name }}:$\{{ inputs.ref }}
            ghcr.io/$\{{ github.repository }}/$\{{ steps.package-name.outputs.package-name }}:$\{{ inputs.version }}
          cache-from: type=registry,ref=ghcr.io/$\{{ github.repository }}/$\{{ steps.package-name.outputs.package-name }}:buildcache
          cache-to: type=registry,ref=ghcr.io/$\{{ github.repository }}/$\{{ steps.package-name.outputs.package-name }}:buildcache,mode=max
