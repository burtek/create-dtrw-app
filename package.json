{
  "name": "@dtrw/create-dtrw-app",
  "version": "1.3.3",
  "description": "CLI for creating and managing @dtrw monorepos",
  "license": "MIT",
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "empathic": "^2.1.0",
    "handlebars": "^4.7.10",
    "obug": "^3.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "commit-and-tag-version": "^13.3.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vitest-fs": "^0.1.1"
  },
  "type": "module",
  "bin": {
    "create-dtrw-app": "dist/create.mjs",
    "dtrw": "dist/dtrw.mjs"
  },
  "files": [
    "dist",
    "templates",
    "templates/*/.env",
    "templates/*/.env.*"
  ],
  "scripts": {
    "build": "tsdown",
    "dev:create": "tsx --conditions import src/cli/create/index.ts",
    "dev:dtrw": "tsx --conditions import src/cli/dtrw/index.ts",
    "test": "vitest run",
    "e2e": "pnpm build && ./test/run.sh --cli=dist/cli.js --suits=./test/suites.yml --mktemp",
    "prerelease": "pnpm test",
    "release": "commit-and-tag-version",
    "prepublish": "pnpm build"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": ">=24",
    "pnpm": ">=8"
  },
  "repository": {
    "url": "https://github.com/burtek/create-dtrw-app"
  }
}
