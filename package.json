{
  "name": "@dtrw/create-dtrw-app",
  "version": "1.3.3",
  "description": "CLI for creating and managing @dtrw monorepos",
  "license": "MIT",
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "empathic": "^2.0.1",
    "handlebars": "^4.7.9",
    "obug": "^2.1.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "commit-and-tag-version": "^13.2.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vitest-fs": "^0.1.1"
  },
  "type": "module",
  "bin": {
    "create-dtrw-app": "dist/create.mjs",
    "dtrw": "dist/dtrw.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsdown",
    "dev:create": "tsx --conditions import src/cli/create/index.ts",
    "dev:dtrw": "tsx --conditions import src/cli/dtrw/index.ts",
    "test": "vitest run",
    "e2e": "pnpm build && ./test/run.sh --cli=dist/cli.js --suits=./test/suites.yml --mktemp",
    "prerelease": "pnpm test",
    "release": "commit-and-tag-version",
    "prepublish": "pnpm build"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=24",
    "pnpm": ">=8"
  }
}
