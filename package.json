{
  "name": "@dtrw/create-dtrw-app",
  "version": "1.3.3",
  "description": "CLI for creating and managing @dtrw monorepos",
  "license": "MIT",
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "empathic": "^2.0.1",
    "handlebars": "^4.7.9",
    "obug": "^2.1.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "commit-and-tag-version": "^13.2.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vitest-fs": "^0.1.1"
  },
  "type": "module",
  "bin": {
    "create-dtrw-app": "dist/create.mjs",
    "dtrw": "dist/dtrw.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsdown",
    "dev:create": "tsx --conditions import src/cli/create/index.ts",
    "dev:dtrw": "tsx --conditions import src/cli/dtrw/index.ts",
    "test": "vitest run",
    "e2e": "pnpm build && ./test/run.sh --cli=dist/cli.js --suits=./test/suites.yml --mktemp",
    "prerelease": "pnpm test",
    "release": "commit-and-tag-version",
    "prepublish": "pnpm build"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "engines": {
    "node": ">=24",
    "pnpm": ">=8"
  }
}
