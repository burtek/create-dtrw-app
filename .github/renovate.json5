{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "enabled",
  "labels": ["dependencies"],
  "assignees": ["@burtek"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"],
    "assignees": ["@burtek"]
  },
  "rebaseWhen": "behind-base-branch",
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "matchFileNames": ["templates/**/*"],
      "labels": ["template-dependencies"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "template-deps"
    },
//    {
//      "matchUpdateTypes": ["patch"],
//      "automerge": true,
//      "automergeType": "pr",
//      "ignoreTests": false
//    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["UPDATE-MAJOR"]
    }
  ]
}
